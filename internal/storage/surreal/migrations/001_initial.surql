BEGIN TRANSACTION;
DEFINE TABLE IF NOT EXISTS schema_migration SCHEMALESS;
DEFINE TABLE IF NOT EXISTS workspace SCHEMALESS;
DEFINE TABLE IF NOT EXISTS membership SCHEMALESS;
DEFINE TABLE IF NOT EXISTS api_token SCHEMALESS;
DEFINE TABLE IF NOT EXISTS project SCHEMALESS;
DEFINE TABLE IF NOT EXISTS repository SCHEMALESS;
DEFINE TABLE IF NOT EXISTS worktree SCHEMALESS;
DEFINE TABLE IF NOT EXISTS source_blob SCHEMALESS;
DEFINE TABLE IF NOT EXISTS source_snapshot SCHEMALESS;
DEFINE TABLE IF NOT EXISTS source_file SCHEMALESS;
DEFINE TABLE IF NOT EXISTS analysis_view SCHEMALESS;
DEFINE TABLE IF NOT EXISTS analysis_artifact SCHEMALESS;
DEFINE TABLE IF NOT EXISTS projection_generation SCHEMALESS;
DEFINE TABLE IF NOT EXISTS projection_head SCHEMALESS;
DEFINE TABLE IF NOT EXISTS job SCHEMALESS;
DEFINE TABLE IF NOT EXISTS import_session SCHEMALESS;
DEFINE INDEX IF NOT EXISTS source_membership ON source_file FIELDS snapshot_id, path;
DEFINE INDEX IF NOT EXISTS source_project ON source_file FIELDS project_ids;
DEFINE INDEX IF NOT EXISTS project_key ON project FIELDS payload.key UNIQUE;
DEFINE INDEX IF NOT EXISTS runnable_job ON job FIELDS status, available_at, priority;
DEFINE INDEX IF NOT EXISTS expired_job ON job FIELDS status, lease_until;
DEFINE INDEX IF NOT EXISTS token_hash ON api_token FIELDS payload.hash UNIQUE;
UPSERT schema_migration:initial SET version = 1;
COMMIT TRANSACTION;
